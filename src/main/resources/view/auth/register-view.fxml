<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane id="AnchorPane" prefHeight="500.0" prefWidth="400.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.cisaacap.redchapina.controller.auth.RegisterController">
    <children>
        <Pane prefHeight="500.0" prefWidth="400.0">
            <children>
                <Label layoutX="164.0" layoutY="80.0" text="Red Chapina" />

                <Label layoutX="105.0" layoutY="135.0" text="Nombre de usuario:" />
                <TextField fx:id="txtUsername" layoutX="105.0" layoutY="171.0" prefWidth="200.0" />

                <Label layoutX="105.0" layoutY="215.0" text="Contraseña:" />
                <PasswordField fx:id="txtPassword" layoutX="105.0" layoutY="238.0" prefWidth="200.0" />

                <Label layoutX="111.0" layoutY="274.0" text="Rol:" />
                <ComboBox fx:id="cmbRol" layoutX="105.0" layoutY="298.0" prefWidth="200.0" />

                <Button fx:id="btnRegister" layoutX="160.0" layoutY="354.0" mnemonicParsing="false" onAction="#handleRegister" text="Registrarse" />
            <Hyperlink layoutX="111.0" layoutY="396.0" onAction="#handleVolverLogin" text="¿Ya tienes cuenta? Inicia Sesión" />
            </children>
        </Pane>
    </children>
</AnchorPane>
