<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.Pane?>

<AnchorPane id="AnchorPane" prefHeight="650.0" prefWidth="900.0" xmlns="http://javafx.com/javafx/21.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.cisaacap.redchapina.controller.aspirantes.AspiranteController">
    <children>
        <Pane prefHeight="650.0" prefWidth="900.0">
            <children>
                <!-- Título e Inventario -->
                <Label layoutX="30.0" layoutY="20.0" text="Inventario de Aspirantes" />
                <Button fx:id="btnCerrarSesion" layoutX="780.0" layoutY="16.0" mnemonicParsing="false" onAction="#handleCerrarSesion" text="Cerrar Sesión" />

                <!-- Formulario - Fila 1 -->
                <Label layoutX="30.0" layoutY="70.0" text="Nombre:" />
                <TextField fx:id="txtNombre" layoutX="90.0" layoutY="66.0" prefWidth="300.0" promptText="Nombre" />

                <Label layoutX="470.0" layoutY="70.0" text="Apellido:" />
                <TextField fx:id="txtApellido" layoutX="540.0" layoutY="66.0" prefWidth="330.0" promptText="Apellido" />

                <!-- Formulario - Fila 2 -->
                <Label layoutX="30.0" layoutY="110.0" text="Correo:" />
                <TextField fx:id="txtCorreo" layoutX="90.0" layoutY="106.0" prefWidth="300.0" promptText="correo@ejemplo.com" />

                <Label layoutX="470.0" layoutY="110.0" text="Teléfono:" />
                <TextField fx:id="txtTelefono" layoutX="540.0" layoutY="106.0" prefWidth="330.0" promptText="12345678" />

                <!-- Formulario - Fila 3 -->
                <Label layoutX="30.0" layoutY="150.0" text="Dirección:" />
                <TextField fx:id="txtDireccion" layoutX="90.0" layoutY="146.0" prefWidth="300.0" promptText="Dirección completa" />

                <Label layoutX="470.0" layoutY="150.0" text="Edad:" />
                <TextField fx:id="txtEdad" layoutX="540.0" layoutY="146.0" prefWidth="330.0" promptText="Edad" />

                <!-- Botones de Acción -->
                <Button fx:id="btnAgregar" layoutX="260.0" layoutY="195.0" mnemonicParsing="false" onAction="#handleAgregar" text="Agregar" />
                <Button fx:id="btnActualizar" layoutX="345.0" layoutY="195.0" mnemonicParsing="false" onAction="#handleActualizar" text="Actualizar" />
                <Button fx:id="btnEliminar" layoutX="440.0" layoutY="195.0" mnemonicParsing="false" onAction="#handleEliminar" text="Eliminar" />
                <Button fx:id="btnLimpiar" layoutX="530.0" layoutY="195.0" mnemonicParsing="false" onAction="#limpiarCampos" text="Limpiar Formulario" />

                <!-- Tabla de Aspirantes -->
                <TableView fx:id="tableAspirantes" layoutX="30.0" layoutY="240.0" prefHeight="380.0" prefWidth="840.0">
                    <columns>
                        <TableColumn fx:id="colId" prefWidth="80.0" text="ID" />
                        <TableColumn fx:id="colNombre" prefWidth="120.0" text="Nombre" />
                        <TableColumn fx:id="colApellido" prefWidth="120.0" text="Apellido" />
                        <TableColumn fx:id="colCorreo" prefWidth="170.0" text="Correo" />
                        <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
                        <TableColumn fx:id="colDireccion" prefWidth="190.0" text="Dirección" />
                        <TableColumn fx:id="colEdad" prefWidth="60.0" text="Edad" />
                    </columns>
                </TableView>
            </children>
        </Pane>
    </children>
</AnchorPane>